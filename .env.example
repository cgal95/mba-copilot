# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
# This encrypts your session cookies - keep it secret!
AUTH_SECRET=your-random-secret-here

# Password for accessing your copilot
# Share this with anyone you want to give access
AUTH_PASSWORD=your-secure-password-here

# OpenAI Configuration
# Always set both OPENAI_API_KEY and OPENAI_BASE_URL

# Option 1: Use OpenAI directly
OPENAI_API_KEY=sk-xxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Option 2: Use Columbia Business School's OpenAI endpoint
# OPENAI_API_KEY=your-instructor-provided-key
# OPENAI_BASE_URL=https://cbsai.business.columbia.edu/api/v1

# Pinecone Configuration
PINECONE_API_KEY=xxxxxxxxxxxx
PINECONE_INDEX=mba-copilot
# ---------------- Startup Hub ----------------
# Email domains allowed to sign in (comma-separated)
ALLOWED_EMAIL_DOMAINS=columbia.edu,gsb.columbia.edu

# Platform admins who can create clubs and manage any club (comma-separated).
# If empty, EVERYONE is an admin in local dev (never in production).
SUPER_ADMIN_EMAILS=

# Optional: real email verification via Google (LionMail is Google Workspace).
# Create OAuth credentials at console.cloud.google.com, redirect URI:
#   https://<your-domain>/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Storage: with BLOB_READ_WRITE_TOKEN set (Vercel Blob), data persists in Blob.
# Without it, data is written to .data/startup-hub.json (local dev only).
